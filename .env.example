# =============================================================================
# Scribe — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# Never commit .env (it contains secrets). .env.example is safe to commit.

# ------------------------------------------------- App
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------- Frontend (Vite)
# Prefixed with VITE_ so they are exposed to the browser build. Never put
# service-role keys or secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=http://localhost:4000

# ------------------------------------------------- Supabase
# Required. Create a project at https://app.supabase.com and copy the values
# from Settings -> API. The service-role key MUST stay server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------- AI Providers
# Initial provider is Gemini. Grok and Claude are optional extension points.
# Set AI_PROVIDER to one of: gemini, xai, anthropic
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Optional: xAI Grok
XAI_API_KEY=
XAI_MODEL=grok-3

# Optional: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307

# ------------------------------------------------- Billing (Razorpay)
# Razorpay test mode for Indian customers (INR).
# Get test keys from https://dashboard.razorpay.com (test mode).
# When both keys are absent, the API falls back to a safe mock billing mode
# that CANNOT grant real production entitlements.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Razorpay plan IDs (create plans in the Razorpay dashboard first)
RAZORPAY_PLAN_ID_FREE=
RAZORPAY_PLAN_ID_PRO=

# ------------------------------------------------- File Limits
# Max upload size per file in MB (conservative default: 15 MB)
MAX_FILE_SIZE_MB=15

# ------------------------------------------------- CORS
# Comma-separated allowlist of origins permitted to call the API
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------- Logging
LOG_LEVEL=info

# ------------------------------------------------- Document Conversion
# Set to "true" only if LibreOffice is installed on the host.
# When unavailable, PDF export is disabled with a clear fallback message.
DOC_CONVERSION_ENABLED=false
LIBREOFFICE_PATH=libreoffice

# Generation execution model
# inline — run the pipeline inside the API process (single instance / dev)
# worker — leave jobs queued for `npm run dev:worker`
GENERATION_MODE=inline
WORKER_POLL_INTERVAL_MS=2000

# ------------------------------------------------- Job Processing
# Database-backed queue is used by default (no Redis required on free tier).
# CONCURRENT_JOBS controls how many generation jobs run at once.
CONCURRENT_JOBS=2
