{
  "name": "projectscribe",
  "private": true,
  "version": "0.1.0",
  "description": "AI Academic Document Generation SaaS for college students",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:worker": "npm --workspace apps/api run dev:worker",
    "build:shared": "npm --workspace packages/shared run build",
    "build:api": "npm --workspace apps/api run build",
    "build:web": "npm --workspace apps/web run build",
    "build": "npm run build:shared && npm run build:api && npm run build:web",
    "test": "npm run test:shared && npm run test:api",
    "test:shared": "npm --workspace packages/shared run test",
    "test:api": "npm --workspace apps/api run test",
    "test:web": "npm --workspace apps/web run test",
    "test:e2e": "npx playwright test",
    "lint": "npm run lint:shared && npm run lint:api && npm run lint:web",
    "lint:shared": "npm --workspace packages/shared run lint",
    "lint:api": "npm --workspace apps/api run lint",
    "lint:web": "npm --workspace apps/web run lint",
    "typecheck": "npm run typecheck:shared && npm run typecheck:api && npm run typecheck:web",
    "typecheck:shared": "npm --workspace packages/shared run typecheck",
    "typecheck:api": "npm --workspace apps/api run typecheck",
    "typecheck:web": "npm --workspace apps/web run typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^6.0.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@tanstack/react-query": "^5.105.0",
    "docx": "^9.15.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/multer": "^2.3.0",
    "jsdom": "^30.1.3",
    "typescript-eslint": "^8.72.1"
  }
}
